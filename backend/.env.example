# Copy to .env and adjust. Never commit .env.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Leave unset to use SQLite. Stage 1 does not need PostgreSQL.
# DATABASE_URL=postgres://testownik:testownik@localhost:5432/testownik

MAX_UPLOAD_SIZE_MB=100

# AI provider: "mock" (no model needed), "gemini" or "ollama"
AI_PROVIDER=mock

# Gemini: create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
MOCK_GENERATION_SECONDS=4

# DEBUG prints the material sent to the AI model and its raw response in the backend console.
AI_LOG_LEVEL=INFO
